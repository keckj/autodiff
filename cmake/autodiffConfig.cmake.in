# Recommended cmake macro use to write a cmake config file.
@PACKAGE_INIT@

# Include the cmake targets of the project if they have not been yet.
if(NOT TARGET autodiff::autodiff)
    include("@PACKAGE_AUTODIFF_INSTALL_CONFIGDIR@/autodiffTargets.cmake")
endif()

find_package(Eigen3 QUIET)

# Check if Eigen has been found
if(Eigen3_FOUND)
    add_definitions(-DAUTODIFF_EIGEN_FOUND)
endif()

# Code compiled at runtime with NVRTC can not use the autodiff::autodiff target: these variables give what is needed
# to build the NVRTC options. The include directories of the CUDA toolkit (CUDAToolkit_INCLUDE_DIRS) and of Eigen
# headers patched for NVRTC (using the patch in autodiff_NVRTC_EIGEN_PATCH_DIR) must be added if Eigen is used, together
# with -DAUTODIFF_EIGEN_FOUND for the Eigen overloads of gradient, jacobian and hessian.
set_and_check(autodiff_INCLUDE_DIR "@PACKAGE_AUTODIFF_INSTALL_INCLUDEDIR@")
set(autodiff_NVRTC_OPTIONS "-std=c++17" "-default-device" "-I${autodiff_INCLUDE_DIR}")
set(autodiff_NVRTC_EIGEN_PATCH_DIR "@PACKAGE_AUTODIFF_INSTALL_NVRTC_EIGEN_PATCHDIR@")

# Recommended check at the end of a cmake config file.
check_required_components(autodiff)
